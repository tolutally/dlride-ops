NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback supported by the server function:
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEKp8XOfnJ4A6Dwp
TURNSTILE_SECRET=
# Shared only by trusted server-side callers and the private applications API.
INTERNAL_API_TOKEN=
# Shared only with the lead-capture integration (e.g. the Botpress HTTP tool).
LEADS_API_TOKEN=
# Railway private-network URL used by server-side callers only.
APPLICATIONS_API_URL=http://dlride-api.railway.internal:8000
MAILTRAP_API_TOKEN=
MAILTRAP_FROM_EMAIL=applications@dlride.com
MAILTRAP_FROM_NAME=DLride Car Rentals
MAILTRAP_REPLY_TO_EMAIL=applications@dlride.com
MAILTRAP_REPLY_TO_NAME=DLride Car Rentals
MAILTRAP_TEMPLATE_APPLICATION_RECEIVED=
MAILTRAP_TEMPLATE_APPLICATION_APPROVED=
MAILTRAP_TEMPLATE_MORE_INFORMATION_REQUIRED=
MAILTRAP_TEMPLATE_APPLICATION_DENIED=
MAILTRAP_TEMPLATE_APPLICATION_CANCELLED=
# Receives new-application staff alerts and Mailtrap test messages.
MAILTRAP_TO_EMAIL=dlriderentals@gmail.com
MAILTRAP_STAFF_CC_EMAIL=hello@dlride.com

# Zoho Mail server integration. Keep all values server-only.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
ZOHO_MAIL_ADDRESS=hello@dlride.com
ZOHO_MAIL_FROM_ALIAS=applications@dlride.com
ZOHO_ACCOUNTS_BASE_URL=https://accounts.zoho.com
ZOHO_MAIL_API_BASE_URL=https://mail.zoho.com
# Optional; each polling run is capped at Zoho's 200-message maximum.
ZOHO_MAIL_SYNC_LIMIT=100

# Temporary initial OAuth setup. Disable and remove the secret after setup.
ZOHO_OAUTH_SETUP_ENABLED=false
ZOHO_SETUP_SECRET=
# Optional when the public callback origin cannot be inferred from the request.
ZOHO_OAUTH_REDIRECT_URI=

# Local-only values used by npm run zoho:test. Never reply to a real customer email.
ZOHO_TEST_RECIPIENT_EMAIL=
ZOHO_TEST_REPLY_MESSAGE_ID=
ZOHO_TEST_REPLY_TO_EMAIL=
